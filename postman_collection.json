              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"CUSTOMER_ID_HERE\",\n  \"items\": [\n    {\n      \"productId\": \"PRODUCT_ID_HERE\",\n      \"quantity\": 5\n    }\n  ],\n  \"status\": \"DRAFT\"\n}"
            },
            "url": {
